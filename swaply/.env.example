# ─── Mode ──────────────────────────────────────────────────────────────
# demo: local demo quotes only (clearly labelled), real exchanges are blocked.
# live: only real provider APIs with configured keys. No demo data ever.
APP_MODE=demo
APP_URL=http://localhost:3000

# ─── Infrastructure ───────────────────────────────────────────────────
DATABASE_URL=postgresql://swaply:swaply@localhost:5432/swaply?schema=public
# Optional. Without it an in-process memory cache / rate limiter is used (single instance only).
REDIS_URL=

# ─── Admin bootstrap (used by `npm run db:seed`) ──────────────────────
ADMIN_EMAIL=admin@example.com
# Min 12 chars. Change before any non-local use.
ADMIN_PASSWORD=change-me-please-123

# ─── ChangeNOW (https://changenow.io/api/docs) ─────────────────────────
# API key from the ChangeNOW affiliate account (sent as x-changenow-api-key, server-side only).
CHANGENOW_API_KEY=
# Exact referral link from your ChangeNOW partner cabinet (Referral links page).
# SWAPLY does not invent attribution parameters: the link is used as given.
# Optional placeholders: {from} {to} {amount} — only add them if ChangeNOW documents them for your link.
CHANGENOW_REFERRAL_URL=

# ─── Swapzone (https://swapzone.io/partners/exchange-api) ──────────────
SWAPZONE_API_KEY=
# Your partner refId; the documented referral link is https://swapzone.io/?refId=<refId>
SWAPZONE_REF_ID=

# ─── Changelly (https://docs.changelly.com) — requires partner approval ─
# Hex-encoded PKCS#8 DER private key as in the official docs. The public key must be registered with Changelly.
CHANGELLY_PRIVATE_KEY=
CHANGELLY_REFERRAL_URL=

# ─── Features ─────────────────────────────────────────────────────────
# Embedded (in-app) exchange creation through partner APIs. Phase 2, off by default.
EMBEDDED_EXCHANGE_ENABLED=false
# Provider request timeout in ms
PROVIDER_TIMEOUT_MS=8000
# How long a floating estimate is shown as fresh when the partner gives no expiry (seconds)
QUOTE_TTL_SECONDS=60
LOG_LEVEL=info
